{
  "name": "polis",
  "version": "0.17.1",
  "type": "module",
  "private": true,
  "description": "Polis — Minecraft Bedrock city generator",
  "scripts": {
    "validate": "node tools/validate.js",
    "validate:fast": "node tools/validate.js --group fast",
    "validate:slow": "node tools/validate.js --group slow",
